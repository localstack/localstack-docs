      "ciCreditsPerAdditional": 20,
      "ciCreditsMaximum": 240
    },
    "Teams": {
      "ciCreditsBase": 1000,
      "ciCreditsBaseNote": "for the first 3 licenses",
      "ciCreditsPerAdditional": 200,
      "ciCreditsMaximum": 2400,
      "includesEphemeralMinutes": true,
      "includesCloudPodStorage": true
    }
  },
