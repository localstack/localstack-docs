{
  "metadata": {
    "lastUpdated": "2026-03-23",
    "description": "Service availability and emulator enhancements for legacy LocalStack for AWS plans (Starter, Teams). These plans are no longer available for new purchases as of May 8, 2025.",
    "plans": ["Starter", "Teams"],
    "note": "Existing customers retain their current plan. New licenses may be purchased under legacy plans during an active subscription."
  },
  "usageAllocations": {
