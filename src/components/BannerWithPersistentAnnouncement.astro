---
import Default from '@astrojs/starlight/components/Banner.astro';

const route = Astro.locals.starlightRoute;
if (route.id.startsWith('aws')) {
  route.entry.data.banner = {
    content:
      'Starting on March 23, 2026, LocalStack for AWS will consolidate into a single image that requires authentication. Learn more about what’s changing and what this means for your setup in <a href="https://blog.localstack.cloud/the-road-ahead-for-localstack/" target="_blank">this blog post</a>.',
  };
}
---

<Default />
